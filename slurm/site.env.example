# Site settings of slurm/run.sh. Copy to slurm/site.env (gitignored) and fill in.
export SLURM_ACCOUNT=<account>
export SLURM_PARTITION=<gpu partition>
# export SLURM_EXCLUDE=<node,node>

# The data root, one directory outside the repositories, shared by the MRX projects:
#   data/                        input files that are not in git
#   runs/<repo>/<experiment>/    run directories and job logs (runs/mrx/ for this repository)
#   paper/  references/  notes/
# Unset, runs go to outputs/ in the repository.
# export MRX_DATA=/path/to/mrx-data
