# Settings of MRX on GKE Cloud TPUs, the only configuration file of the Makefile and the gke/ scripts. Copy it to
# gcp.env and set PROJECT_ID to the team's shared project:
#   cp gcp.env.example gcp.env
export PROJECT_ID="${PROJECT_ID:-your-gcp-project-id}"

# Prefix of your image tag and job names in the shared clusters (default: your login name):
# export MRX_USER="${MRX_USER:-your-name}"

# TPU families (gke/README.md, "Where to start"). The v6e cluster runs in V6E_REGION, or in V6E_BACKUP_REGION when
# make setup cannot create it there; the v5p cluster in V5P_REGION. With both, each cluster also gets the other family
# where its region offers it, and a job runs in the first TPU pool to get a node
# export ENABLE_TPU_V5P="true"
export ENABLE_TPU_V6E="true"

export V5P_REGION="${V5P_REGION:-us-east5}"
export V6E_REGION="${V6E_REGION:-us-east1}"
export V6E_BACKUP_REGION="${V6E_BACKUP_REGION:-us-central1}"
# Region of the bucket (XLA cache, outputs) and the Artifact Registry, which both clusters share
export REGION="${REGION:-us-east5}"

# Network and service accounts (optional). The defaults suit most projects: the project's "default" VPC, nodes with
# external IP addresses, and the project's default service accounts. For stricter org policies (gke/README.md,
# "Network and org policies"):
# export CREATE_NETWORK="true"    # Terraform creates a VPC for the clusters (mrx-net)
# export NETWORK="your-vpc"       # or use an existing VPC with a subnet named
# export SUBNETWORK="your-subnet" #   SUBNETWORK (default: NETWORK) in each cluster region
# export PRIVATE_NODES="true"     # nodes without external IP addresses
# export DEDICATED_SERVICE_ACCOUNTS="true"  # nodes and builds run as their own service
#                                           # accounts (make setup then needs Owner)

# Pin every job to mrx-tpu-v5p or mrx-tpu-v6e (gke/compute-classes.yaml). Default: the enabled family; per job,
# TPU_GEN=v5p or TPU_GEN=v6e on the make command line
# export COMPUTE_CLASS="mrx-tpu-v6e"

# Default workload of make deploy and make run. Per job, set SCRIPT, ARGS or RUNS on the make command line
# (gke/README.md)
export SCRIPT="${SCRIPT:-scripts/relax.py}"
export ARGS="${ARGS:---geometry.path data/wout_li383_1.4m.nc --geometry.resolution 12 20 12 --budget.steps 20}"
